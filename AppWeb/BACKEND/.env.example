DATABASE_URL=postgresql+psycopg2://cortex:cortex@localhost:5432/cortex # En Docker, docker-compose sobreescribe esta variable para apuntar al servicio 'db'.Para desarrollo local, apunta a tu Postgres local:
SECRET_KEY=secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEMINI_API_KEY=api_key
ANTHROPIC_API_KEY=api_key
GROQ_API_KEY=api_key
REDIS_URL=redis://localhost:6379/0
STORAGE_BASE=Storage/ArchivosUsuarios
